+def build_feasible(inst):
+    """Return (feasible(perm), late_pos): the front-loading feasibility predicate.
+
+    Front-loading requires every large block to sit in an early slot. Equivalently,
+    no large block may occupy a NON-early ("late") position. There are only a
+    handful of late positions, so checking them is O(#late) for ANY move type
+    (swap or relocation), which lets the search use a richer neighborhood cheaply."""
+    blocks = list(inst["all_blocks"])
+    pos = {slot: i for i, slot in enumerate(blocks)}
+    large = set(inst["large_blocks"])
+    early_pos = set(pos[s] for s in inst["early_slots"])
+    late_pos = [p for p in range(len(blocks)) if p not in early_pos]
+
+    def feasible(perm):
+        for p in late_pos:
+            if perm[p] in large:
+                return False
+        return True
+
+    return feasible, late_pos
+
+
+def relocate(perm, p, q):
+    """or-opt(1): remove the block at position p and re-insert it at position q,
+    shifting the intervening blocks by one. Length-preserving; returns a new list."""
+    x = list(perm)
+    b = x.pop(p)
+    x.insert(q, b)
+    return x
+
+
+def greedy_descent(obj, perm, swap_ok, deadline, feasible=None):
