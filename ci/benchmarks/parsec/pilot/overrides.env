# Parsec / aap2 sub-agent pilot — Harbor adapter + 4 kaegis sim endpoints
# ITERATIONS and GATE_K_SE are workflow-owned — set at dispatch time.
PARSEC_ADAPTER=harbor
# Point HARBOR at Parsec's harbor-tasks shadow (docker_image + MCP URLs + verify.py prefix-strip)
# The shadow is regenerated by scripts/patch-harbor-tasks.sh from RH's original harbor-tasks/.
HARBOR_LOCAL_ASIS=1
# 4 kaegis sim endpoints (aap2 :8086, github :8087, babylon :8088, provisions_db :8090).
# BACKEND_MCP_URL retained for compatibility with the RH-authored task.toml placeholder.
BACKEND_MCP_URL=http://host.containers.internal:8086/mcp/sse
