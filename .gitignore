# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
.venv-*/
venv/

# local E2E scratch (venvs, benchmark clones, run artifacts, .env credentials)
e2e/

# cap-evolve run state (per-run, not source). Globbed, because a run driven against an
# alternate project dir lands in a sibling like .capevolve-agentopt/ — which is 12M of
# rollouts and must not be committable by accident. Curated audit sets go under examples/.
.capevolve*/

# secrets — never commit credentials (RITS_API_KEY, WATSONX_*, ANTHROPIC_API_KEY, …)
.env
.env.*
!.env.example

# OS
.DS_Store
.demo/

# keep the prebuilt dashboard frontend (served at runtime; no node needed)
!dashboard/frontend/dist/
!dashboard/frontend/dist/**

# keep the vendored Reveal.js used by the management-review deck
!presentation/reveal/dist/
!presentation/reveal/dist/**

# keep the prebuilt evograph weakness-graph view (served by scripts/view.py at runtime)
!skills/algorithms/evograph/dashboard/frontend/dist/
!skills/algorithms/evograph/dashboard/frontend/dist/**

# skillsbench example: local clone + bench cache + run scratch (not committed)
vendor/
.bench_cwd/
.bench_runs/
examples/skillsbench/run/
.cache/

# skillsbench seed skills are Anthropic-licensed — extracted from the SkillsBench clone
# by setup.sh at onboarding time, NOT vendored here (only the README is tracked).
examples/skillsbench/seed_capability/*
!examples/skillsbench/seed_capability/README.md

# CI benchmark scratch (per-task work dirs)
ci/benchmarks/.work/

# generic dashboard-ui shell built fresh by pages.yml (CI-only, never committed)
site/dashboard-ui/
